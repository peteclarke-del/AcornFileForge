+class NewMapMount(AcornWildcards):
+    """A transactional, writable classic FileCore E/F mount.
+
+    Mutations rebuild the floppy map into a fresh bytearray and publish
+    it only after every directory and checksum has been generated.  This is
+    slower than editing map links in place, but prevents a failed operation
+    from leaving one map copy or one directory half-written.
+    """
+
+    wildcard_syntax = ACORN_WILDCARDS
+    name_grammar = ADFS_NAME_GRAMMAR
+
+    def __init__(self, buffer: memoryview, record: NewMapDiscRecord):
+        self._buffer = buffer
+        self._record = record
+        self._map = (
+            SingleZoneNewMap(buffer, record)
+            if record.zones == 1
+            else MultiZoneNewMap(buffer, record)
+        )
+        self._directory_format = NewDirectoryFormat(record.sector_size)
+        self._referenced_ids: set[int] = {2}
+        self._root = self._load_directory(record.root_address, None)
+        allocated = {
+            fragment.fragment_id
+            for fragment in self._map.fragments
+            if not fragment.free and fragment.fragment_id not in {1, 2}
+        }
+        self._unreferenced_ids = allocated - self._referenced_ids
+        self._has_defects = any(
+            fragment.fragment_id == 1 and not fragment.free
+            for fragment in self._map.fragments
+        )
+
+    def _load_directory(self, address: int, name: str | None) -> _Node:
+        parsed = self._directory_format.parse(
+            memoryview(self._map.read_object(address, 2048)), address
+        )
+        node = _Node(
+            name=name if name is not None else parsed.name,
+            is_directory=True,
+            title=parsed.title,
+            sequence=parsed.sequence_number,
+            address=address,
+            attributes=_directory_attributes(
+                _ADFSRawAttributes(True, True, False, True, False, True, False, False, False)
+            ),
+        )
+        for entry in parsed.entries:
+            fragment_id = (entry.indirect_disc_address >> 8) & 0x7FFF
+            if entry.length:
+                self._referenced_ids.add(fragment_id)
+            if entry.is_directory:
+                child = self._load_directory(entry.indirect_disc_address, entry.name)
+                child.load_address = entry.load_address
+                child.exec_address = entry.exec_address
+                child.attributes = entry.attributes
+            else:
+                child = _Node(
+                    name=entry.name,
+                    is_directory=False,
+                    load_address=entry.load_address,
+                    exec_address=entry.exec_address,
+                    attributes=entry.attributes,
+                    data=self._map.read_object(entry.indirect_disc_address, entry.length)
+                    if entry.length
+                    else b"",
+                    address=entry.indirect_disc_address,
+                )
+            node.children.append(child)
