+        node = self._root
+        for index, part in enumerate(parts[1:]):
+            child = self._child(node, part)
+            final = index == len(parts) - 2
+            if child is not None:
+                if not child.is_directory:
+                    raise ADFSPathError(f"'{part}' is not a directory")
+                if final and not exist_ok:
+                    raise ADFSEntryExistsError(f"'{path}' already exists")
+                node = child
+                continue
+            if not final and not parents:
+                raise ADFSPathError(f"parent directory for '{path}' does not exist")
+            if len(node.children) >= self._directory_format.max_entries:
+                raise ADFSDirectoryFullError(f"directory '{node.name}' is full")
+            ADFS_NAME_GRAMMAR.validate(part)
+            child = _Node(
+                name=part,
+                is_directory=True,
+                title=title if final and title is not None else part,
+                attributes=_directory_attributes(_Node("", False).attributes),
+            )
+            node.children.append(child)
+            node = child
+        self._commit()
+
+    def remove(self, path: str, *, force: bool = False) -> None:
+        self._ensure_rebuild_safe()
+        parent, name = self._parent(path)
+        node = self._child(parent, name)
+        if node is None:
+            raise ADFSPathError(f"'{path}' does not exist")
+        if node.attributes.locked and not force:
+            raise ADFSFileLockedError(f"'{name}' is locked")
+        if node.is_directory and node.children:
+            raise ADFSPathError(f"directory '{name}' is not empty")
+        parent.children.remove(node)
+        self._commit()
+
+    def rename(self, old_path: str, new_path: str) -> None:
+        self._ensure_rebuild_safe()
+        old_parent, old_name = self._parent(old_path)
+        node = self._child(old_parent, old_name)
+        if node is None:
+            raise ADFSPathError(f"'{old_path}' does not exist")
+        new_parent, new_name = self._parent(new_path)
+        if self._child(new_parent, new_name) is not None:
+            raise ADFSEntryExistsError(f"'{new_path}' already exists")
+        if len(new_parent.children) >= self._directory_format.max_entries:
+            raise ADFSDirectoryFullError(f"directory '{new_parent.name}' is full")
+        old_parent.children.remove(node)
+        node.name = new_name
+        new_parent.children.append(node)
+        self._commit()
+
+    # Metadata and capabilities
+    def acorn_meta(self, path: str) -> AcornMeta:
+        node = self._find(path)
+        access = 0
+        for enabled, flag in (
+            (node.attributes.owner_read, Access.R),
+            (node.attributes.owner_write, Access.W),
+            (node.attributes.locked, Access.L),
+            (node.attributes.public_read, Access.PR),
+            (node.attributes.public_write, Access.PW),
+        ):
+            if enabled:
+                access |= int(flag)
+        return AcornMeta(node.load_address, node.exec_address, access)
+
+    def set_acorn_meta(self, path: str, meta: AcornMeta) -> None:
+        self._ensure_rebuild_safe()
+        node = self._find(path)
+        if meta.load_address is not None:
+            node.load_address = meta.load_address
+        if meta.exec_address is not None:
+            node.exec_address = meta.exec_address
+        if meta.access is not None:
+            value = int(meta.access)
+            node.attributes = _ADFSRawAttributes(
+                owner_read=bool(value & int(Access.R)),
+                owner_write=bool(value & int(Access.W)),
+                locked=bool(value & int(Access.L)),
+                directory=node.is_directory,
+                owner_execute=False,
+                public_read=bool(value & int(Access.PR)),
+                public_write=bool(value & int(Access.PW)),
+                public_execute=False,
+                private=False,
+            )
+        self._commit()
+
+    @property
+    def datestamp_resolution(self) -> timedelta:
+        return timedelta(milliseconds=10)
+
+    def filetype(self, path: str) -> int | None:
+        load = self._find(path).load_address
+        return (load >> 8) & 0xFFF if is_datestamped(load) else None
+
+    def set_filetype(self, path: str, filetype: int) -> None:
+        self._ensure_rebuild_safe()
+        node = self._find(path)
+        date_high = node.load_address & 0xFF if is_datestamped(node.load_address) else 0
+        if not is_datestamped(node.load_address):
+            node.exec_address = 0
+        node.load_address = 0xFFF00000 | ((filetype & 0xFFF) << 8) | date_high
+        self._commit()
+
+    def datestamp(self, path: str) -> datetime | None:
+        node = self._find(path)
+        return decode_datestamp(node.load_address, node.exec_address)
+
+    def set_datestamp(self, path: str, when: datetime) -> None:
+        self._ensure_rebuild_safe()
+        node = self._find(path)
+        filetype = (node.load_address >> 8) & 0xFFF if is_datestamped(node.load_address) else 0xFFD
+        date_high, node.exec_address = encode_datestamp(when)
+        node.load_address = 0xFFF00000 | (filetype << 8) | date_high
+        self._commit()
+
+    @property
+    def title(self) -> str:
+        return self._root.title
+
+    def set_title(self, title: str) -> None:
+        self._ensure_rebuild_safe()
+        self._root.title = title
+        self._commit()
+
+    def directory_title(self, path: str) -> str:
+        node = self._find(path)
+        if not node.is_directory:
+            raise ADFSPathError(f"'{path}' is not a directory")
+        return node.title
+
+    def set_directory_title(self, path: str, title: str) -> None:
+        self._ensure_rebuild_safe()
+        node = self._find(path)
+        if not node.is_directory:
+            raise ADFSPathError(f"'{path}' is not a directory")
+        node.title = title
+        self._commit()
+
+    @property
+    def boot_option(self) -> BootOption:
+        return BootOption(self._record.boot_option)
+
+    def set_boot_option(self, option) -> None:
+        self._ensure_rebuild_safe()
+        self._record = self._record.__class__(
+            **{**self._record.__dict__, "boot_option": int(BootOption(option))}
+        )
+        self._commit()
+
+    def free_bytes(self) -> int:
+        return self._map.free_space
+
+    def size_bytes(self) -> int:
+        return self._record.disc_size
+
+    def disc_geometry(self) -> DiscGeometry:
+        return DiscGeometry(
+            label=self._record.geometry.label,
+            sectors_per_cylinder=self._record.heads * self._record.sectors_per_track,
+            total_sectors=self._record.disc_size // self._record.sector_size,
+        )
+
+    def free_map(self) -> FreeMapData:
+        regions = tuple(
+            (fragment.physical_offset // self._record.sector_size,
+             fragment.length // self._record.sector_size)
+            for fragment in self._map.fragments if fragment.free
+        )
+        return FreeMapData(
+            free_regions=regions,
+            total_sectors=self._record.disc_size // self._record.sector_size,
+        )
+
+    def compact(self, *, order=()) -> int:
+        if order:
+            raise ValueError("ADFS E compaction does not support an explicit order")
+        self._commit()
+        return sum(1 for _node in self._walk(self._root)) - 1
+
+    def validate(self) -> list[ADFSValidationError]:
+        errors = []
+        if self._has_defects:
+            errors.append(ADFSValidationError("the image contains a FileCore defect object"))
+        for fragment_id in sorted(self._unreferenced_ids):
+            errors.append(ADFSValidationError(f"allocated object {fragment_id} is unreferenced"))
+        return errors
+
+    def reserved_regions(self):
+        return ()
+
+    @staticmethod
+    def _walk(root: _Node):
+        yield root
+        for child in root.children:
+            yield child
+            if child.is_directory:
+                yield from NewMapMount._walk_children(child)
+
+    @staticmethod
+    def _walk_children(parent: _Node):
+        for child in parent.children:
+            yield child
+            if child.is_directory:
+                yield from NewMapMount._walk_children(child)
+
+    def _commit(self) -> None:
+        self._ensure_rebuild_safe()
+        if self._record.zones > 1:
+            self._commit_multi_zone()
+            return
+        image = bytearray(self._record.disc_size)
+        sector_size = self._record.sector_size
+        unit = 1 << self._record.log2_bytes_per_map_bit
+        allocation_bits = self._map.allocation_bits
+
+        nodes = list(self._walk(self._root))
+        self._root.address = self._record.root_address
+        next_id = 3
+        layout: list[tuple[int, int, _Node | None]] = [(2, 4 * sector_size // unit, self._root)]
+        for node in nodes[1:]:
+            if not node.is_directory and not node.data:
+                node.address = 0
+                continue
+            node.address = next_id << 8
+            next_id += 1
+            bits = max(
+                self._record.id_length + 1,
+                (node.length + unit - 1) // unit,
+            )
+            sector_bits = sector_size // unit
+            bits = ((bits + sector_bits - 1) // sector_bits) * sector_bits
+            layout.append((node.address >> 8, bits, node))
+
+        used = sum(bits for _fragment_id, bits, _node in layout)
+        if used > allocation_bits:
+            raise ADFSDiscFullError(
+                f"ADFS E image needs {used * unit:,} allocated bytes but has "
+                f"{allocation_bits * unit:,}"
+            )
+        remaining = allocation_bits - used
+        if 0 < remaining < self._record.id_length + 1:
+            fragment_id, bits, node = layout[-1]
+            layout[-1] = (fragment_id, bits + remaining, node)
+            remaining = 0
+        if remaining:
+            layout.append((0, remaining, None))
+
+        record = bytearray(60)
+        record[0] = self._record.sector_size.bit_length() - 1
+        record[1] = self._record.sectors_per_track
+        record[2] = self._record.heads
+        record[3] = self._record.density
+        record[4] = self._record.id_length
+        record[5] = self._record.log2_bytes_per_map_bit
+        record[6] = 1
+        record[7] = self._record.boot_option
+        record[9] = 1
+        record[10:12] = self._record.zone_spare.to_bytes(2, "little")
+        record[12:15] = self._record.root_address.to_bytes(3, "little")
+        record[16:20] = self._record.disc_size.to_bytes(4, "little")
+        record[20:22] = ((self._record.disc_id + 1) & 0xFFFF).to_bytes(2, "little")
+        record[22:32] = self._record.disc_name.encode("latin-1")[:10].ljust(10, b" ")
+
+        map_block = bytearray(sector_size)
+        map_block[3] = 0xFF
+        map_block[4:64] = record
+        allocation_start = 64 * 8
+        bit_offset = 0
+
+        def set_bit(absolute: int) -> None:
+            map_block[absolute // 8] |= 1 << (absolute & 7)
+
+        free_start = None
+        physical: dict[int, int] = {}
+        for fragment_id, bits, node in layout:
+            if fragment_id:
+                physical[fragment_id] = bit_offset * unit
+                for bit in range(self._record.id_length):
+                    if fragment_id & (1 << bit):
+                        set_bit(allocation_start + bit_offset + bit)
+            else:
+                free_start = bit_offset
+            set_bit(allocation_start + bit_offset + bits - 1)
+            bit_offset += bits
+        if free_start is not None:
+            link = allocation_start + free_start - 8
+            map_block[1:3] = (link | (1 << self._record.id_length)).to_bytes(2, "little")
+        map_block[0] = zone_checksum(map_block)
+        image[:sector_size] = map_block
+        image[sector_size : 2 * sector_size] = map_block
+
+        def write_directory(node: _Node, parent_address: int) -> None:
+            entries = tuple(
+                _ADFSDirectoryEntry(
+                    name=child.name,
+                    load_address=child.load_address,
+                    exec_address=child.exec_address,
+                    length=child.length,
+                    indirect_disc_address=child.address,
+                    sequence_number=0,
+                    attributes=child.attributes,
+                )
+                for child in sorted(node.children, key=lambda item: item.name.casefold())
+            )
+            directory = _ADFSDirectory(
+                name=node.name,
+                title=node.title,
+                parent_address=parent_address,
+                disc_address=node.address,
+                entries=entries,
+                sequence_number=(node.sequence + 1) & 0xFF,
+            )
+            output = memoryview(bytearray(2048))
+            self._directory_format.serialize(directory, output)
+            start = 2 * sector_size if node is self._root else physical[node.address >> 8]
+            image[start : start + 2048] = output
+            for child in node.children:
+                if child.is_directory:
+                    write_directory(child, node.address)
+
+        write_directory(self._root, self._root.address)
+        for node in nodes[1:]:
+            if not node.is_directory and node.data:
+                start = physical[node.address >> 8]
+                image[start : start + len(node.data)] = node.data
+
+        # Publish only after the complete replacement image validates.
+        replacement_record = NewMapDiscRecord(
+            **{
+                **self._record.__dict__,
+                "disc_id": (self._record.disc_id + 1) & 0xFFFF,
+            }
+        )
+        replacement = SingleZoneNewMap(memoryview(image), replacement_record)
+        replacement_format = NewDirectoryFormat(sector_size)
+        replacement_format.parse(
+            memoryview(replacement.read_object(replacement_record.root_address, 2048)),
+            replacement_record.root_address,
+        )
+        self._buffer[:] = image
+        self._record = replacement_record
+        self._map = SingleZoneNewMap(self._buffer, replacement_record)
+        self._referenced_ids = {
+            node.address >> 8 for node in nodes if node.address
+        }
+        self._unreferenced_ids = set()
+
+    def _commit_multi_zone(self) -> None:
+        """Transactionally rebuild a conventional multi-zone FileCore map."""
+
+        image = bytearray(self._buffer)
+        record = self._record
+        sector_size = record.sector_size
+        unit = 1 << record.log2_bytes_per_map_bit
+        common_bits = sector_size * 8 - record.zone_spare
+        zone_bits = [common_bits - 60 * 8] + [common_bits] * (record.zones - 1)
+        described_bytes = sum(zone_bits) * unit
+        overhang_bits = (described_bytes - record.disc_size) // unit
+        if described_bytes < record.disc_size or overhang_bits < 0:
+            raise ADFSDiscFullError("FileCore map does not cover the complete image")
+        ids_per_zone = common_bits // (record.id_length + 1)
+
+        nodes = list(self._walk(self._root))
+        self._root.address = record.root_address
+        layouts: list[list[tuple[int, int, _Node | None]]] = [
+            [] for _zone in range(record.zones)
+        ]
+        # Object 2 begins in the map zone. Its earlier fragment carries the
+        # boot block; the map-zone fragment carries both maps and the root.
+        layouts[0].append((2, 4 * sector_size // unit, None))
+        map_zone = record.zones // 2
+        object_two_map_bits = (2 * record.zones * sector_size + 2048) // unit
+        layouts[map_zone].append((2, object_two_map_bits, self._root))
+
+        capacities = list(zone_bits)
+        capacities[record.zones - 1] -= overhang_bits
+        used = [sum(bits for _fragment_id, bits, _node in rows) for rows in layouts]
+        id_counters = [max(3, zone * ids_per_zone) for zone in range(record.zones)]
+        zone = 0
+        sector_bits = sector_size // unit
+        for node in nodes[1:]:
+            if not node.is_directory and not node.data:
+                node.address = 0
+                continue
+            bits = max(record.id_length + 1, (node.length + unit - 1) // unit)
+            bits = ((bits + sector_bits - 1) // sector_bits) * sector_bits
+            while zone < record.zones and used[zone] + bits > capacities[zone]:
+                zone += 1
+            if zone == record.zones:
+                raise ADFSDiscFullError(
+                    f"ADFS {record.format_name} has insufficient contiguous zone space "
+                    f"for '{node.name}' ({node.length:,} bytes)"
+                )
+            fragment_id = id_counters[zone]
+            if fragment_id >= (zone + 1) * ids_per_zone:
+                raise ADFSDiscFullError(f"FileCore map zone {zone} has no fragment IDs left")
+            id_counters[zone] += 1
+            node.address = fragment_id << 8
+            layouts[zone].append((fragment_id, bits, node))
+            used[zone] += bits
+
+        for zone_number in range(record.zones):
+            remaining = capacities[zone_number] - used[zone_number]
+            if 0 < remaining < record.id_length + 1:
+                fragment_id, bits, node = layouts[zone_number][-1]
+                layouts[zone_number][-1] = (fragment_id, bits + remaining, node)
+                remaining = 0
+            if remaining:
+                layouts[zone_number].append((0, remaining, None))
+        if overhang_bits:
+            layouts[-1].append((1, overhang_bits, None))
+
+        record_bytes = bytearray(60)
+        record_bytes[0] = sector_size.bit_length() - 1
+        record_bytes[1] = record.sectors_per_track
+        record_bytes[2] = record.heads
+        record_bytes[3] = record.density
+        record_bytes[4] = record.id_length
+        record_bytes[5] = record.log2_bytes_per_map_bit
+        record_bytes[6] = 1
+        record_bytes[7] = record.boot_option
+        record_bytes[9] = record.zones
+        record_bytes[10:12] = record.zone_spare.to_bytes(2, "little")
+        record_bytes[12:15] = record.root_address.to_bytes(3, "little")
+        record_bytes[16:20] = record.disc_size.to_bytes(4, "little")
+        record_bytes[20:22] = ((record.disc_id + 1) & 0xFFFF).to_bytes(2, "little")
+        record_bytes[22:32] = record.disc_name.encode("latin-1")[:10].ljust(10, b" ")
+
+        physical: dict[int, int] = {}
+        physical_base = 0
+        blocks: list[bytearray] = []
+        for zone_number, rows in enumerate(layouts):
+            block = bytearray(sector_size)
+            block[3] = 0xFF if zone_number == 0 else 0
+            allocation_start = 64 * 8 if zone_number == 0 else 4 * 8
+            if zone_number == 0:
+                block[4:64] = record_bytes
+            bit_offset = 0
+            free_start = None
+
+            def set_bit(absolute: int) -> None:
+                block[absolute // 8] |= 1 << (absolute & 7)
+
+            for fragment_id, bits, node in rows:
+                if fragment_id:
+                    # Object 2 has multiple fragments; the root is in the
+                    # map-zone fragment, while its zone-zero fragment keeps
+                    # the boot block and must not replace that address.
+                    if fragment_id != 2 or node is self._root:
+                        physical[fragment_id] = physical_base + bit_offset * unit
+                    for bit in range(record.id_length):
+                        if fragment_id & (1 << bit):
+                            set_bit(allocation_start + bit_offset + bit)
+                else:
+                    free_start = bit_offset
+                set_bit(allocation_start + bit_offset + bits - 1)
+                bit_offset += bits
+            if bit_offset != zone_bits[zone_number]:
+                raise AssertionError(f"zone {zone_number} layout does not fill its map block")
+            if free_start is not None:
+                link = allocation_start + free_start - 8
+                block[1:3] = (link | (1 << record.id_length)).to_bytes(2, "little")
+            block[0] = zone_checksum(block)
+            blocks.append(block)
+            physical_base += zone_bits[zone_number] * unit
+
+        for copy in range(2):
+            copy_start = record.map_offset + copy * record.zones * sector_size
+            for zone_number, block in enumerate(blocks):
+                start = copy_start + zone_number * sector_size
+                image[start : start + sector_size] = block
+
+        # F media also carries the geometry in the boot block. Keep its
+        # defect list and hardware fields, update the disc record used during
+        # mount, then restore the boot checksum.
+        boot_record = bytearray(record_bytes)
+        boot_record[20:32] = b"\0" * 12
+        image[0xDC0:0xDFC] = boot_record
+        boot = memoryview(image)[0xC00:0xE00]
+        boot[0x1FF] = boot_block_checksum(boot)
+
+        def write_directory(node: _Node, parent_address: int) -> None:
+            entries = tuple(
+                _ADFSDirectoryEntry(
+                    name=child.name,
+                    load_address=child.load_address,
+                    exec_address=child.exec_address,
+                    length=child.length,
+                    indirect_disc_address=child.address,
+                    sequence_number=0,
+                    attributes=child.attributes,
+                )
+                for child in sorted(node.children, key=lambda item: item.name.casefold())
+            )
+            directory = _ADFSDirectory(
+                name=node.name,
+                title=node.title,
+                parent_address=parent_address,
+                disc_address=node.address,
+                entries=entries,
+                sequence_number=(node.sequence + 1) & 0xFF,
+            )
+            output = memoryview(bytearray(2048))
+            self._directory_format.serialize(directory, output)
+            if node is self._root:
+                start = record.map_offset + 2 * record.zones * sector_size
+            else:
+                start = physical[node.address >> 8]
+            image[start : start + 2048] = output
+            for child in node.children:
+                if child.is_directory:
+                    write_directory(child, node.address)
+
+        write_directory(self._root, self._root.address)
+        for node in nodes[1:]:
+            if not node.is_directory and node.data:
+                start = physical[node.address >> 8]
+                image[start : start + len(node.data)] = node.data
+
+        replacement_record = NewMapDiscRecord(
+            **{**record.__dict__, "disc_id": (record.disc_id + 1) & 0xFFFF}
+        )
+        replacement = MultiZoneNewMap(memoryview(image), replacement_record)
+        self._directory_format.parse(
+            memoryview(replacement.read_object(replacement_record.root_address, 2048)),
+            replacement_record.root_address,
+        )
+        self._buffer[:] = image
+        self._record = replacement_record
+        self._map = MultiZoneNewMap(self._buffer, replacement_record)
+        self._referenced_ids = {node.address >> 8 for node in nodes if node.address}
+        self._unreferenced_ids = set()
