+            raise ADFSPathError(f"invalid ADFS path: {path!r}")
+        return parts
+
+    @staticmethod
+    def _child(parent: _Node, name: str) -> _Node | None:
+        key = name.casefold()
+        return next((item for item in parent.children if item.name.casefold() == key), None)
+
+    def _find(self, path: str) -> _Node:
+        node = self._root
+        for part in self._parts(path)[1:]:
+            if not node.is_directory:
+                raise ADFSPathError(f"'{node.name}' is not a directory")
+            child = self._child(node, part)
+            if child is None:
+                raise ADFSPathError(f"'{part}' not found in '{path}'")
+            node = child
+        return node
