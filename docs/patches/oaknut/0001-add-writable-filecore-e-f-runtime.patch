+    record_model = NewMapDiscRecord(
+        format_name="E",
+        disc_name=disc_name.decode("latin-1").rstrip(" "),
+        disc_size=len(image),
+        sector_size=1024,
+        sectors_per_track=5,
+        heads=2,
