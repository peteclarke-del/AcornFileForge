+                    load_address=int.from_bytes(data[offset + 10 : offset + 14], "little"),
+                    exec_address=int.from_bytes(data[offset + 14 : offset + 18], "little"),
+                    length=int.from_bytes(data[offset + 18 : offset + 22], "little"),
+                    indirect_disc_address=_read_24bit_le(data, offset + 22),
+                    sequence_number=0,
