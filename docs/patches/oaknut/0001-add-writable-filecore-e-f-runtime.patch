+        root_address=0x203,
+        boot_option=boot_option,
+        disc_id=disc_id & 0xFFFF,
+        map_offset=0,
+        geometry=floppy_geometry(
+            tracks=80,
+            sides=2,
+            sectors_per_track=5,
+            bytes_per_sector=1024,
+            label="ADFS E (80T DS)",
+        ),
+    )
+    SingleZoneNewMap(memoryview(image), record_model)
