+class MultiZoneNewMap:
+    """Read a FileCore new map whose allocation is split across zones."""
+
+    def __init__(self, buffer: memoryview, record: NewMapDiscRecord):
+        if record.zones < 2:
+            raise ValueError("MultiZoneNewMap requires at least two zones")
+        self.buffer = buffer
+        self.record = record
+        self._blocks: list[memoryview] = []
+        for zone in range(record.zones):
+            start = record.map_offset + zone * record.sector_size
+            primary = buffer[start : start + record.sector_size]
+            secondary_start = start + record.zones * record.sector_size
+            secondary = buffer[secondary_start : secondary_start + record.sector_size]
+            if primary[0] != zone_checksum(primary):
+                raise ValueError(f"primary FileCore map zone {zone} has an invalid ZoneCheck")
+            if secondary[0] != zone_checksum(secondary):
+                raise ValueError(f"secondary FileCore map zone {zone} has an invalid ZoneCheck")
+            if bytes(primary) != bytes(secondary):
+                raise ValueError(f"the two copies of FileCore map zone {zone} differ")
+            self._blocks.append(primary)
+        cross_check = 0
+        for block in self._blocks:
+            cross_check ^= block[3]
+        if cross_check != 0xFF:
+            raise ValueError("FileCore map CrossCheck values do not combine to 0xFF")
+        self.fragments = self._parse_fragments()
+
+    @property
+    def bytes_per_map_bit(self) -> int:
+        return 1 << self.record.log2_bytes_per_map_bit
+
+    @property
+    def common_zone_bits(self) -> int:
+        return self.record.sector_size * 8 - self.record.zone_spare
+
+    @property
+    def ids_per_zone(self) -> int:
+        return self.common_zone_bits // (self.record.id_length + 1)
+
+    def _parse_fragments(self) -> tuple[Fragment, ...]:
+        fragments: list[Fragment] = []
+        physical_base = 0
+        id_mask = (1 << self.record.id_length) - 1
+        for zone, block in enumerate(self._blocks):
+            allocation_start = 64 * 8 if zone == 0 else 4 * 8
+            allocation_bits = self.common_zone_bits - (
+                _DISC_RECORD_SIZE * 8 if zone == 0 else 0
+            )
+
+            def bit(offset: int) -> int:
+                absolute = allocation_start + offset
+                return (block[absolute // 8] >> (absolute & 7)) & 1
+
+            blocks: list[tuple[int, int, int]] = []
+            offset = 0
+            while offset < allocation_bits:
+                fragment_id = sum(
+                    bit(offset + index) << index
+                    for index in range(self.record.id_length)
+                )
+                terminator = offset + self.record.id_length
+                while terminator < allocation_bits and not bit(terminator):
+                    terminator += 1
+                if terminator >= allocation_bits:
+                    raise ValueError(f"unterminated fragment in FileCore map zone {zone}")
+                length = terminator - offset + 1
+                blocks.append((offset, fragment_id, length))
+                offset = terminator + 1
+
+            free_offsets: set[int] = set()
+            link = int.from_bytes(block[1:3], "little") & id_mask
+            if link:
+                current = 8 + link - allocation_start
+                by_offset = {start: (fragment_id, length) for start, fragment_id, length in blocks}
+                while current not in free_offsets:
+                    if current not in by_offset:
+                        raise ValueError(
+                            f"FileCore free chain in zone {zone} points outside a fragment"
+                        )
+                    free_offsets.add(current)
+                    next_link, _length = by_offset[current]
+                    if next_link == 0:
+                        break
+                    current += next_link
+
+            unit = self.bytes_per_map_bit
+            for start, fragment_id, length in blocks:
+                physical_offset = physical_base + start * unit
+                physical_length = min(
+                    length * unit,
+                    max(0, self.record.disc_size - physical_offset),
+                )
+                # Object 1 deliberately maps the allocation tail beyond the
+                # real end of many discs. It is metadata, not an extent that
+                # can be read from the image.
+                if physical_length:
+                    fragments.append(
+                        Fragment(
+                            fragment_id=fragment_id,
+                            physical_offset=physical_offset,
+                            length=physical_length,
+                            free=start in free_offsets,
+                        )
+                    )
+            physical_base += allocation_bits * unit
+        if physical_base < self.record.disc_size:
+            raise ValueError(
+                f"FileCore zones describe only {physical_base} of {self.record.disc_size} bytes"
+            )
+        return tuple(fragments)
+
+    def object_fragments(self, fragment_id: int) -> tuple[Fragment, ...]:
+        matching = [
+            fragment
+            for fragment in self.fragments
+            if not fragment.free and fragment.fragment_id == fragment_id
+        ]
+        if fragment_id == 2:
+            start_zone = self.record.zones // 2
+        else:
+            start_zone = (fragment_id // self.ids_per_zone) % self.record.zones
+        zone_size = [
+            (self.common_zone_bits - (_DISC_RECORD_SIZE * 8 if zone == 0 else 0))
+            * self.bytes_per_map_bit
+            for zone in range(self.record.zones)
+        ]
+        zone_starts = []
+        position = 0
+        for size in zone_size:
+            zone_starts.append(position)
+            position += size
+
+        def zone_of(fragment: Fragment) -> int:
+            return max(
+                index
+                for index, start in enumerate(zone_starts)
+                if fragment.physical_offset >= start
+            )
+
+        return tuple(
+            sorted(
+                matching,
+                key=lambda fragment: (
+                    (zone_of(fragment) - start_zone) % self.record.zones,
+                    fragment.physical_offset,
+                ),
+            )
+        )
+
+    def read_object(self, internal_address: int, length: int) -> bytes:
+        fragment_id = (internal_address >> 8) & 0x7FFF
+        sector_offset = internal_address & 0xFF
+        skip = (sector_offset - 1) * self.record.sector_size if sector_offset else 0
+        output = bytearray()
+        for fragment in self.object_fragments(fragment_id):
+            if skip >= fragment.length:
+                skip -= fragment.length
+                continue
+            start = fragment.physical_offset + skip
+            take = min(length - len(output), fragment.length - skip)
+            output.extend(self.buffer[start : start + take])
+            skip = 0
+            if len(output) == length:
+                break
+        if len(output) != length:
+            raise ValueError(
+                f"disc object {fragment_id} provides {len(output)} of {length} requested bytes"
+            )
+        return bytes(output)
+
+    @property
+    def free_space(self) -> int:
+        return sum(fragment.length for fragment in self.fragments if fragment.free)
+
+
+def initialise_e_image(
+    buffer: memoryview,
+    *,
+    title: str = "",
+    boot_option: int = 0,
+    disc_id: int = 0,
+) -> None:
+    """Format an 800 KiB buffer as an empty ADFS E filesystem."""
+
+    if len(buffer) != 800 * 1024:
+        raise ValueError("ADFS E requires an 800 KiB buffer")
