diff --git a/packages/oaknut-adfs/src/oaknut/adfs/new_map.py b/packages/oaknut-adfs/src/oaknut/adfs/new_map.py
new file mode 100644
index 0000000..c8f635c
--- /dev/null
+++ b/packages/oaknut-adfs/src/oaknut/adfs/new_map.py
@@ -0,0 +1,695 @@
+"""FileCore new-map recognition and object translation."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from oaknut.filesystem import Geometry, ImageReader, floppy_geometry
+
+_DISC_RECORD_OFFSET = 4
+_DISC_RECORD_SIZE = 60
+
+
+@dataclass(frozen=True)
+class NewMapDiscRecord:
+    format_name: str
+    disc_name: str
+    disc_size: int
+    sector_size: int
+    sectors_per_track: int
+    heads: int
+    density: int
+    id_length: int
+    log2_bytes_per_map_bit: int
+    zones: int
+    zone_spare: int
+    root_address: int
+    boot_option: int
+    disc_id: int
+    map_offset: int
+    geometry: Geometry
+
+
+def probe_new_map_disc_record(reader: ImageReader) -> NewMapDiscRecord | None:
+    """Return a checked new-map disc record, or ``None`` for other data.
+
+    A FileCore new map has two copies.  The copy begins one filesystem
+    sector after the first, so matching both complete disc records avoids
+    treating a coincidental byte pattern as a filesystem signature.
+    """
+
+    candidates = (
+        reader.read(_DISC_RECORD_OFFSET, _DISC_RECORD_SIZE),
+        reader.read(0xDC0, _DISC_RECORD_SIZE),  # boot-block disc record (F/hard media)
+    )
+    seed = next(
+        (
+            candidate
+            for candidate in candidates
+            if len(candidate) == _DISC_RECORD_SIZE and 8 <= candidate[0] <= 12
+        ),
+        None,
+    )
+    if seed is None:
+        return None
+    sector_size = 1 << seed[0]
+
+    zones = seed[9]
+    zone_spare = int.from_bytes(seed[10:12], "little")
+    log2_bytes_per_map_bit = seed[5]
+    if not zones or not zone_spare or log2_bytes_per_map_bit > 31:
+        return None
+    common_zone_bits = sector_size * 8 - zone_spare
+    zone_zero_bits = common_zone_bits - _DISC_RECORD_SIZE * 8
+    middle_zone = zones // 2
+    preceding_bits = (
+        0
+        if middle_zone == 0
+        else zone_zero_bits + (middle_zone - 1) * common_zone_bits
+    )
+    map_offset = preceding_bits << log2_bytes_per_map_bit
+    first = reader.read(map_offset + _DISC_RECORD_OFFSET, _DISC_RECORD_SIZE)
+    second = reader.read(
+        map_offset + zones * sector_size + _DISC_RECORD_OFFSET,
+        _DISC_RECORD_SIZE,
+    )
+    if len(first) != _DISC_RECORD_SIZE or second != first:
+        return None
+
+    sectors_per_track, heads, density = first[1], first[2], first[3]
+    id_length, log2_bytes_per_map_bit = first[4], first[5]
+    zones = first[9]
+    disc_size = int.from_bytes(first[16:20], "little")
+    if not (
+        sectors_per_track
+        and 1 <= heads <= 16
+        and density in {0, 1, 2, 3, 4, 8}
+        and 8 <= id_length <= 15
+        and log2_bytes_per_map_bit <= 31
+        and zones
+        and disc_size == reader.size
+        and disc_size % sector_size == 0
+        and any(first[4:12])
+    ):
+        return None
+
+    identified = _format_and_geometry(
+        disc_size, sector_size, sectors_per_track, heads, density
+    )
+    if identified is None:
+        return None
+    format_name, geometry = identified
+    return NewMapDiscRecord(
+        format_name=format_name,
+        disc_name=first[22:32].decode("latin-1", errors="replace").rstrip(" \0"),
+        disc_size=disc_size,
+        sector_size=sector_size,
+        sectors_per_track=sectors_per_track,
+        heads=heads,
+        density=density,
+        id_length=id_length,
+        log2_bytes_per_map_bit=log2_bytes_per_map_bit,
+        zones=zones,
+        zone_spare=int.from_bytes(first[10:12], "little"),
+        root_address=int.from_bytes(first[12:15], "little"),
+        boot_option=first[7],
+        disc_id=int.from_bytes(first[20:22], "little"),
+        map_offset=map_offset,
+        geometry=geometry,
+    )
+
+
+def _format_and_geometry(
+    size: int, sector_size: int, sectors_per_track: int, heads: int, density: int
+) -> tuple[str, Geometry] | None:
+    if (size, sector_size, sectors_per_track, heads, density) == (
+        800 * 1024,
+        1024,
+        5,
+        2,
+        2,
+    ):
+        return "E", floppy_geometry(
+            tracks=80,
+            sides=2,
+            sectors_per_track=5,
+            bytes_per_sector=1024,
+            label="ADFS E (80T DS)",
+        )
+    if (size, sector_size, sectors_per_track, heads, density) == (
+        1600 * 1024,
+        1024,
+        10,
+        2,
+        4,
+    ):
+        return "F", floppy_geometry(
+            tracks=80,
+            sides=2,
+            sectors_per_track=10,
+            bytes_per_sector=1024,
+            label="ADFS F (80T DS)",
+        )
+    return None
+
+
+@dataclass(frozen=True)
+class Fragment:
+    """One physical extent belonging to a FileCore disc object."""
+
+    fragment_id: int
+    physical_offset: int
+    length: int
+    free: bool
+
+
+def zone_checksum(block: bytes | bytearray | memoryview) -> int:
+    """Calculate FileCore's ZoneCheck byte for one map block."""
+
+    if len(block) % 4:
+        raise ValueError("map block size must be a multiple of four")
+    sums = [0, 0, 0, 0]
+    # FileCore walks words backwards. Byte zero, the stored checksum, is
+    # omitted while bytes 1..3 of the first word remain in the calculation.
+    for offset in range(len(block) - 4, 0, -4):
+        sums[0] += block[offset] + (sums[3] >> 8)
+        sums[3] &= 0xFF
+        sums[1] += block[offset + 1] + (sums[0] >> 8)
+        sums[0] &= 0xFF
+        sums[2] += block[offset + 2] + (sums[1] >> 8)
+        sums[1] &= 0xFF
+        sums[3] += block[offset + 3] + (sums[2] >> 8)
+        sums[2] &= 0xFF
+    sums[0] += sums[3] >> 8
+    sums[1] += block[1] + (sums[0] >> 8)
+    sums[2] += block[2] + (sums[1] >> 8)
+    sums[3] += block[3] + (sums[2] >> 8)
+    return (sums[0] ^ sums[1] ^ sums[2] ^ sums[3]) & 0xFF
+
+
+class SingleZoneNewMap:
+    """Read and rebuild the one-zone new map used by ADFS E.
+
+    The public parser recognises F as well, but F's four-zone allocator is
+    intentionally a separate implementation: treating it as a large E disc
+    would corrupt both copies of its distributed map.
+    """
+
+    def __init__(self, buffer: memoryview, record: NewMapDiscRecord):
+        if record.zones != 1:
+            raise ValueError("SingleZoneNewMap requires exactly one zone")
+        self.buffer = buffer
+        self.record = record
+        self._map = buffer[: record.sector_size]
+        if self._map[0] != zone_checksum(self._map):
+            raise ValueError("primary FileCore map has an invalid ZoneCheck")
+        secondary = buffer[record.sector_size : 2 * record.sector_size]
+        if secondary[0] != zone_checksum(secondary):
+            raise ValueError("secondary FileCore map has an invalid ZoneCheck")
+        if bytes(self._map) != bytes(secondary):
+            raise ValueError("the two FileCore map copies differ")
+        self.fragments = self._parse_fragments()
+
+    @property
+    def bytes_per_map_bit(self) -> int:
+        return 1 << self.record.log2_bytes_per_map_bit
+
+    @property
+    def allocation_start_bit(self) -> int:
+        return (_DISC_RECORD_OFFSET + _DISC_RECORD_SIZE) * 8
+
+    @property
+    def allocation_bits(self) -> int:
+        # ZoneSpare includes the 32-bit map header; zone zero additionally
+        # replaces 60 bytes of allocation data with the disc record.
+        return (
+            self.record.sector_size * 8
+            - self.record.zone_spare
+            - _DISC_RECORD_SIZE * 8
+        )
+
+    def _bit(self, allocation_offset: int) -> int:
+        absolute = self.allocation_start_bit + allocation_offset
+        return (self._map[absolute // 8] >> (absolute & 7)) & 1
+
+    def _field(self, allocation_offset: int, width: int) -> int:
+        return sum(self._bit(allocation_offset + bit) << bit for bit in range(width))
+
+    def _parse_fragments(self) -> tuple[Fragment, ...]:
+        blocks: list[tuple[int, int, int]] = []
+        offset = 0
+        while offset < self.allocation_bits:
+            fragment_id = self._field(offset, self.record.id_length)
+            terminator = offset + self.record.id_length
+            while terminator < self.allocation_bits and not self._bit(terminator):
+                terminator += 1
+            if terminator >= self.allocation_bits:
+                raise ValueError("unterminated FileCore fragment block")
+            length_bits = terminator - offset + 1
+            blocks.append((offset, fragment_id, length_bits))
+            offset = terminator + 1
+
+        free_offsets: set[int] = set()
+        free_link = int.from_bytes(self._map[1:3], "little") & ((1 << self.record.id_length) - 1)
+        if free_link:
+            # FreeLink is measured from the start of its own 16-bit block.
+            current = 8 + free_link - self.allocation_start_bit
+            by_offset = {start: (fragment_id, length) for start, fragment_id, length in blocks}
+            while current not in free_offsets:
+                if current not in by_offset:
+                    raise ValueError("FileCore free-space chain points outside a fragment")
+                free_offsets.add(current)
+                link, _length = by_offset[current]
+                if link == 0:
+                    break
+                current += link
+
+        unit = self.bytes_per_map_bit
+        return tuple(
+            Fragment(
+                fragment_id=fragment_id,
+                physical_offset=start * unit,
+                length=length * unit,
+                free=start in free_offsets,
+            )
+            for start, fragment_id, length in blocks
+        )
+
+    def object_fragments(self, fragment_id: int) -> tuple[Fragment, ...]:
+        return tuple(
+            fragment
+            for fragment in self.fragments
+            if not fragment.free and fragment.fragment_id == fragment_id
+        )
+
+    def read_object(self, internal_address: int, length: int) -> bytes:
+        fragment_id = (internal_address >> 8) & 0x7FFF
+        sector_offset = internal_address & 0xFF
+        skip = (sector_offset - 1) * self.record.sector_size if sector_offset else 0
+        output = bytearray()
+        for fragment in self.object_fragments(fragment_id):
+            if skip >= fragment.length:
+                skip -= fragment.length
+                continue
+            start = fragment.physical_offset + skip
+            take = min(length - len(output), fragment.length - skip)
+            output.extend(self.buffer[start : start + take])
+            skip = 0
+            if len(output) == length:
+                break
+        if len(output) != length:
+            raise ValueError(
+                f"disc object {fragment_id} provides {len(output)} of {length} requested bytes"
+            )
+        return bytes(output)
+
+    @property
+    def free_space(self) -> int:
+        return sum(fragment.length for fragment in self.fragments if fragment.free)
