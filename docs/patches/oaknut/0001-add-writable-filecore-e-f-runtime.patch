+    def _parent(self, path: str) -> tuple[_Node, str]:
+        parts = self._parts(path)
+        if len(parts) == 1:
+            raise ADFSPathError("the root directory has no mutable parent entry")
+        parent = self._find(".".join(parts[:-1]))
+        if not parent.is_directory:
+            raise ADFSPathError("parent is not a directory")
