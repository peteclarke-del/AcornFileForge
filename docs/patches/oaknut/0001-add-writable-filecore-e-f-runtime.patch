+
+def boot_block_checksum(block: bytes | bytearray | memoryview) -> int:
+    """Return the FileCore checksum for bytes 0..510 of a boot block."""
+
+    if len(block) != 512:
+        raise ValueError("a FileCore boot block is exactly 512 bytes")
+    result = 0
+    for value in reversed(block[:511]):
+        result = (result & 0xFF) + (result >> 8)
+        result += value
+    return result & 0xFF
+
