# Local disk images and test collections can be large and may contain software
# that cannot be redistributed. Keep the whole samples tree out of Git.
/samples/
/output/

# Acorn File Forge working data belongs in Docker's named volume.
/work/

# Release artefacts from tools/build-release.sh and build-linux-package.sh
/dist/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
test-results/
playwright-report/
.venv-desktop/
.venv/

# Local editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
.claude/
